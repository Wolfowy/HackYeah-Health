# Copy to .env when using an existing PostgreSQL on the Docker host.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=2142
POSTGRES_DATABASE=docprep
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-existing-postgres-password
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_ENVIRONMENT=production
ELEVENLABS_WEBHOOK_SECRET=

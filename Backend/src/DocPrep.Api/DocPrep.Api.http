@host = http://localhost:8080
@adminKey = demo-admin-key
@clinicianKey = demo-clinician-key
@staffAccessToken = {{staffLogin.response.body.$.accessToken}}
@staffRefreshToken = {{staffLogin.response.body.$.refreshToken}}

### Logowanie personelu administracyjnego
# @name staffLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@docprep.local",
  "password": "DocPrepDemo!2026"
}

### Kontekst zalogowanego użytkownika panelu
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{staffAccessToken}}

### Odnowienie sesji personelu (token jest rotowany)
# Refresh token z logowania jest jednorazowy; przed powtórzeniem odnowienia
# zaloguj się ponownie albo użyj refreshToken z odpowiedzi poprzedniego odnowienia.
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{staffRefreshToken}}" }

### Utworzenie wizyty przez integrację serwer-serwer
POST {{host}}/api/v1/integration/visits
Content-Type: application/json
X-Api-Key: {{adminKey}}

{
  "externalVisitId": "visit-001",
  "pesel": "44051401458",
  "scheduledAt": "2026-12-10T10:00:00Z",
  "serviceExpiresAt": "2026-12-11T10:00:00Z",
  "contact": "+48123123123",
  "channel": "Sms",
  "assignedClinicianId": "doctor-demo"
}

### Dashboard panelu przez JWT (alternatywnie można użyć API key serwer-serwer)
GET {{host}}/api/v1/integration/visits
Authorization: Bearer {{staffAccessToken}}

### Wymiana link tokenu zwróconego przy tworzeniu wizyty
@linkToken = replace-me
POST {{host}}/api/v1/patient-access/link/exchange
Content-Type: application/json

{ "token": "{{linkToken}}" }

### Kontekst pojedynczego wywiadu pacjenta
@patientSession = replace-me
GET {{host}}/api/v1/interview
Authorization: Bearer {{patientSession}}

### Lista udostępnionych wersji dla przypisanego lekarza
@visitId = 00000000-0000-0000-0000-000000000000
GET {{host}}/api/v1/integration/visits/{{visitId}}/report-versions
X-Api-Key: {{clinicianKey}}

### Walidacja publicznego zaproszenia ElevenLabs
@interviewInvitationToken = replace-me
GET {{host}}/api/public/interviews/{{interviewInvitationToken}}

### Wymiana tokenu zaproszenia na anonimowy JWT
POST {{host}}/api/public/interviews/{{interviewInvitationToken}}/authorize

### Rozpoczęcie rozmowy voice przez WebRTC
@anonymousInterviewToken = replace-me
@interviewId = 00000000-0000-0000-0000-000000000000
POST {{host}}/api/interviews/{{interviewId}}/sessions
Authorization: Bearer {{anonymousInterviewToken}}
Content-Type: application/json

{ "mode": "Voice" }

### Rozpoczęcie chatu przez signed WebSocket URL
POST {{host}}/api/interviews/{{interviewId}}/sessions
Authorization: Bearer {{anonymousInterviewToken}}
Content-Type: application/json

{ "mode": "Text" }

### Powiązanie conversationId zwróconego przez startSession()
@interviewSessionId = 00000000-0000-0000-0000-000000000000
PUT {{host}}/api/interview-sessions/{{interviewSessionId}}/provider-conversation
Authorization: Bearer {{anonymousInterviewToken}}
Content-Type: application/json

{ "conversationId": "conv_replace-me" }

### Status przetwarzania wywiadu
GET {{host}}/api/interviews/{{interviewId}}
Authorization: Bearer {{anonymousInterviewToken}}

### Wynik po webhooku post_call_transcription
GET {{host}}/api/interviews/{{interviewId}}/result
Authorization: Bearer {{anonymousInterviewToken}}
